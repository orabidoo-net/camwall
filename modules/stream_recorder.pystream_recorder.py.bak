#!/usr/bin/env python3
import json
import os
import re
import signal
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path
from typing import Optional

# Basis-Verzeichnisse
BASE_DIR = Path.home() / ".local" / "share" / "camwall"
RECORDINGS_DIR = BASE_DIR / "recordings"
SCREENSHOTS_DIR = BASE_DIR / "screenshots"
RECORDER_LOG = BASE_DIR / "recorder.log"
ACTIVE_RECORDING_FILE = BASE_DIR / "active_recording.json"


def ensure_dirs() -> None:
    """Stellt sicher, dass die benötigten Verzeichnisse existieren."""
    for d in (BASE_DIR, RECORDINGS_DIR, SCREENSHOTS_DIR):
        d.mkdir(parents=True, exist_ok=True)


def log(msg: str) -> None:
    """Schreibt eine Zeile ins Recorder-Log mit Zeitstempel."""
    ensure_dirs()
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}\n"
    with RECORDER_LOG.open("a", encoding="utf-8") as f:
        f.write(line)


def slugify_title(title: str) -> str:
    """Macht aus einem Titel einen Dateinamen-geeigneten Slug."""
    slug = re.sub(r"[^a-zA-Z0-9_-]+", "_", title).strip("_")
    return slug or "aufnahme"


def get_direct_stream_url(
    url: str, cookies_from_browser: Optional[str] = None
) -> str:
    """
    Holt eine direkt abspielbare Stream-URL über yt-dlp -g.

    Wird für Screenshots benutzt, damit ffmpeg nicht die Watch-URL bekommt,
    sondern die HLS-/Direkt-URL.
    """
    ensure_dirs()
    cmd = ["yt-dlp", "-g"]
    if cookies_from_browser:
        cmd += ["--cookies-from-browser", cookies_from_browser]
    cmd.append(url)

    log(f"get_direct_stream_url: Starte yt-dlp: {' '.join(cmd)}")

    try:
        proc = subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError as e:
        raise RuntimeError("yt-dlp wurde nicht gefunden. Ist es installiert?") from e

    if proc.returncode != 0:
        msg = (
            "yt-dlp konnte die Stream-URL nicht ermitteln.\n"
            f"Befehl: {' '.join(cmd)}\n"
            f"stdout:\n{proc.stdout}\n\nstderr:\n{proc.stderr}"
        )
        log(f"get_direct_stream_url: FEHLER\n{msg}")
        raise RuntimeError(msg)

    # yt-dlp -g kann mehrere Zeilen ausgeben (Audio/Video getrennt),
    # für unsere Zwecke nehmen wir die erste nicht-leere Zeile.
    lines = [l.strip() for l in proc.stdout.splitlines() if l.strip()]
    if not lines:
        msg = "yt-dlp -g hat keine verwertbare URL geliefert."
        log(f"get_direct_stream_url: FEHLER – {msg}")
        raise RuntimeError(msg)

    direct_url = lines[0]
    log(f"get_direct_stream_url: Erfolgreich, erste URL: {direct_url[:120]}...")
    return direct_url


def start_recording(
    url: str, title: str, cookies_from_browser: Optional[str] = None
) -> dict:
    """
    Startet eine Aufnahme per yt-dlp in einem eigenen Prozess.

    Gibt ein Dict mit Metadaten zurück und schreibt ACTIVE_RECORDING_FILE.
    """
    ensure_dirs()
    timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    slug = slugify_title(title)
    outfile = RECORDINGS_DIR / f"{timestamp}_{slug}.mp4"
    logfile = RECORDINGS_DIR / f"{timestamp}_{slug}.log"

    cmd = ["yt-dlp"]
    if cookies_from_browser:
        cmd += ["--cookies-from-browser", cookies_from_browser]

    # "best" ist okay, yt-dlp übernimmt den Rest; Warnung ist kosmetisch.
    cmd += ["-f", "best", "-o", str(outfile), url]

    log(f"Starte Aufnahme mit Befehl: {' '.join(cmd)}")

    lf = logfile.open("w", encoding="utf-8")
    proc = subprocess.Popen(
        cmd,
        stdout=lf,
        stderr=subprocess.STDOUT,
    )

    info = {
        "pid": proc.pid,
        "cmd": cmd,
        "output_file": str(outfile),
        "log_file": str(logfile),
        "started_at": datetime.now().isoformat(timespec="seconds"),
        "stream_url": url,
        "title": title,
    }
    if cookies_from_browser:
        info["cookies_from_browser"] = cookies_from_browser

    ACTIVE_RECORDING_FILE.write_text(json.dumps(info, indent=2, ensure_ascii=False))
    log(f"Aktive Aufnahme geschrieben: {info}")

    return info


def stop_recording() -> bool:
    """
    Stoppt eine laufende Aufnahme anhand von ACTIVE_RECORDING_FILE.

    Schickt ein SIGINT (wie Strg+C), damit yt-dlp den Stream sauber finalisiert.
    Gibt True zurück, wenn eine Aufnahme gefunden und ein Signal gesendet wurde.
    """
    ensure_dirs()
    if not ACTIVE_RECORDING_FILE.exists():
        log("stop_recording: keine ACTIVE_RECORDING_FILE gefunden.")
        return False

    try:
        active = json.loads(ACTIVE_RECORDING_FILE.read_text(encoding="utf-8"))
    except Exception as e:
        log(f"stop_recording: konnte ACTIVE_RECORDING_FILE nicht lesen/parsen: {e}")
        ACTIVE_RECORDING_FILE.unlink(missing_ok=True)
        return False

    pid = active.get("pid")
    if not isinstance(pid, int):
        log("stop_recording: ACTIVE_RECORDING_FILE hat keinen gültigen pid-Eintrag.")
        ACTIVE_RECORDING_FILE.unlink(missing_ok=True)
        return False

    # Prüfen, ob der Prozess noch lebt
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        log(
            "stop_recording: Prozess existiert nicht mehr, "
            "ACTIVE_RECORDING_FILE wird entfernt."
        )
        ACTIVE_RECORDING_FILE.unlink(missing_ok=True)
        return False

    # Statt SIGTERM -> SIGINT schicken (entspricht Strg+C)
    try:
        log(f"stop_recording: Sende SIGINT an PID {pid}")
        os.kill(pid, signal.SIGINT)
    except Exception as e:
        log(f"stop_recording: Fehler beim Senden von SIGINT: {e}")
        ACTIVE_RECORDING_FILE.unlink(missing_ok=True)
        return False

    # Kurz warten, damit yt-dlp/ffmpeg sauber finalisieren können
    time.sleep(3)

    # Prüfen, ob der Prozess noch lebt
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        log("stop_recording: Prozess nach SIGINT beendet.")
    else:
        log(
            "stop_recording: Prozess lebt nach SIGINT noch. "
            "Evtl. läuft die Aufnahme weiter oder wird später beendet."
        )

    ACTIVE_RECORDING_FILE.unlink(missing_ok=True)
    log("stop_recording: ACTIVE_RECORDING_FILE entfernt, Aufnahme gestoppt (Signal gesendet).")
    return True


def take_screenshot(
    url: str, title: str = "screenshot", cookies_from_browser: Optional[str] = None
) -> str:
    """
    Nimmt mit ffmpeg einen Screenshot des Streams.

    Wichtig: nutzt vorher yt-dlp -g, um eine direkt spielbare URL zu bekommen.
    """
    ensure_dirs()
    timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    slug = slugify_title(title)
    outfile = SCREENSHOTS_DIR / f"{timestamp}_{slug}.png"

    # 1) Direkt-URL besorgen
    direct_url = get_direct_stream_url(url, cookies_from_browser)

    # 2) ffmpeg aufrufen – wir nehmen z. B. nach 5 Sekunden einen Frame
    cmd = [
        "ffmpeg",
        "-y",          # überschreiben ohne Nachfrage
        "-loglevel",
        "error",       # nur Fehler ausgeben
        "-ss",
        "5",           # 5 Sekunden vorspulen
        "-i",
        direct_url,
        "-frames:v",
        "1",
        str(outfile),
    ]

    log(f"take_screenshot: Starte ffmpeg: {' '.join(cmd)}")

    try:
        proc = subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError as e:
        raise RuntimeError("ffmpeg wurde nicht gefunden. Ist es installiert?") from e

    if proc.returncode != 0 or not outfile.exists():
        err_msg = (
            "ffmpeg konnte keinen Screenshot erstellen.\n\n"
            f"Fehler:\n{proc.stderr}"
        )
        log(f"take_screenshot: FEHLER\n{err_msg}")
        raise RuntimeError(err_msg)

    log(f"take_screenshot: Screenshot erfolgreich erstellt: {outfile}")
    return str(outfile)


def main() -> None:
    """
    CLI-Interface:

      python3 -m modules.stream_recorder record <url> <title> [browser]
      python3 -m modules.stream_recorder stop
      python3 -m modules.stream_recorder shot <url> <title> [browser]
    """
    if len(sys.argv) < 2:
        print(
            "Verwendung:\n"
            "  python3 -m modules.stream_recorder record <url> <title> [browser]\n"
            "  python3 -m modules.stream_recorder stop\n"
            "  python3 -m modules.stream_recorder shot <url> <title> [browser]"
        )
        sys.exit(1)

    mode = sys.argv[1].lower()

    if mode == "record":
        if len(sys.argv) < 4:
            print("record: Erwartet <url> und <title> (optional [browser])")
            sys.exit(1)
        url = sys.argv[2]
        title = sys.argv[3]
        browser = sys.argv[4] if len(sys.argv) >= 5 else None

        info = start_recording(url, title, cookies_from_browser=browser)
        print("Aufnahme gestartet:")
        print(json.dumps(info, indent=2, ensure_ascii=False))

    elif mode == "stop":
        ok = stop_recording()
        if ok:
            print("Aufnahme gestoppt.")
        else:
            print("Aufnahme gestoppt (oder war bereits beendet).")

    elif mode == "shot":
        if len(sys.argv) < 4:
            print("shot: Erwartet <url> und <title> (optional [browser])")
            sys.exit(1)
        url = sys.argv[2]
        title = sys.argv[3]
        browser = sys.argv[4] if len(sys.argv) >= 5 else None

        try:
            path = take_screenshot(url, title=title, cookies_from_browser=browser)
        except RuntimeError as e:
            print(str(e))
            sys.exit(1)

        print(f"Screenshot erstellt: {path}")

    else:
        print(f"Unbekannter Modus: {mode}")
        sys.exit(1)


if __name__ == "__main__":
    main()
